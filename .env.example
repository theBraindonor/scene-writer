# scene.agent LLM runtime configuration (see e001-agent-llm-runtime).
# Copy this file to .env and fill in real values; .env is gitignored.

# Required. Names a profile from models.yaml (see models.example.yaml) to
# use for the coordinating agent (story/scene/character/location tool-calling).
SCENE_COORDINATING_AGENT=

# Names a profile from models.yaml to use for the future rendering agent.
# Not consumed by this campaign yet, but the selector exists now so the
# rendering agent can be pointed at a different model independently once
# it exists.
SCENE_RENDERING_AGENT=

# Names a profile from models.yaml to use for the continuity-editor agent,
# which turns an accepted scene rendering into a compact continuity_snapshot.
# May point at the same profile as SCENE_RENDERING_AGENT, or a different one
# better suited to reliable, conservative factual extraction.
SCENE_CONTINUITY_AGENT=

# API keys referenced by model profiles' `api_key_env` field in models.yaml,
# e.g. a profile with `api_key_env: OPENROUTER_API_KEY`:
OPENROUTER_API_KEY=
